@prefix dao: <https://w3id.org/daont#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix res: <https://example.org/paw/resource/> .

res:dilithium-6533647a72 a dao:PostQuantumCryptographicAlgorithm,
        dao:SignatureAlgorithm ;
    rdfs:label "DILITHIUM" ;
    rdfs:comment "Original CRYSTALS name for the ML-DSA scheme" ;
    dao:isTechnologyVersionOf res:ml-dsa-1a2b3c4d5e .

res:ntt-d4cc2e3bab a dao:CryptographicAlgorithm ;
    rdfs:label "NTT" ;
    rdfs:comment "Number Theoretic Transform representation used in the ML-DSA construction" .

res:cmvp-9a0b1c2d3e a dao:Requirement ;
    rdfs:label "CMVP Validation" ;
    rdfs:comment "Cryptographic Module Validation Program for testing implementations for conformance to FIPS 204" .

res:deterministic-signing-7e8f9a0b1c a dao:SoftwareFeature ;
    rdfs:label "Deterministic Signing" ;
    rdfs:comment "A signing mode specified in FIPS 204 producing the same signature for the same input" .

res:fips-186-5-2d3e4f5a6b a dao:Documentation ;
    rdfs:label "FIPS 186-5" ;
    rdfs:comment "Referenced standard specifying additional digital signature schemes" .

res:fips-204-7f8e9a0b1c a dao:Documentation ;
    rdfs:label "FIPS 204" ;
    rdfs:comment "Module-Lattice-Based Digital Signature Standard published by NIST on August 13, 2024" ;
    dao:hasDocumentation res:fips-186-5-2d3e4f5a6b,
        res:fips-205-4e5f6a7b8c,
        res:sp-800-140c-8b9c0d1e2f,
        res:sp-800-208-6f7a8b9c0d ;
    dao:hasRequirement res:cmvp-9a0b1c2d3e .

res:fips-205-4e5f6a7b8c a dao:Documentation ;
    rdfs:label "FIPS 205" ;
    rdfs:comment "Referenced standard for public-key-based signature systems" .

res:hedged-signing-5c6d7e8f9a a dao:SoftwareFeature ;
    rdfs:label "Hedged Signing" ;
    rdfs:comment "A signing mode specified in FIPS 204 using additional randomness during signature generation" .

res:lattice-based-cryptography-3a4b5c6d7e a dao:Technology ;
    rdfs:label "Lattice-Based Cryptography" ;
    rdfs:comment "Mathematical foundation for ML-DSA, believed secure against large-scale quantum computers" .

res:ml-dsa-1a2b3c4d5e a dao:PostQuantumCryptographicAlgorithm,
        dao:SignatureAlgorithm ;
    rdfs:label "ML-DSA" ;
    rdfs:comment "Module-Lattice-Based Digital Signature Algorithm specified in FIPS 204 for generating and verifying digital signatures" ;
    dao:hasDocumentation res:fips-204-7f8e9a0b1c ;
    dao:hasRequirement res:non-repudiation-b1c2d3e4f5,
        res:post-quantum-security-a0b1c2d3e4 ;
    dao:isTechnologyVersionOf res:lattice-based-cryptography-3a4b5c6d7e ;
    dao:providesFeature res:deterministic-signing-7e8f9a0b1c,
        res:hedged-signing-5c6d7e8f9a .

res:non-repudiation-b1c2d3e4f5 a dao:Requirement ;
    rdfs:label "Non-Repudiation" ;
    rdfs:comment "Digital signature provides evidence that the signature was generated by the claimed signatory" .

res:post-quantum-security-a0b1c2d3e4 a dao:Requirement ;
    rdfs:label "Post-Quantum Security" ;
    rdfs:comment "ML-DSA is believed secure against adversaries in possession of a large-scale quantum computer" .

res:sp-800-140c-8b9c0d1e2f a dao:Documentation ;
    rdfs:label "SP 800-140C" ;
    rdfs:comment "List of approved security functions for cryptographic algorithms protecting Federal Government-sensitive information" .

res:sp-800-208-6f7a8b9c0d a dao:Documentation ;
    rdfs:label "NIST SP 800-208" ;
    rdfs:comment "Referenced standard for public-key-based signature systems" .

