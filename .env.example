# Secret used to HMAC application API tokens. Generate a unique random value.
EXTRACTOR_SYSTEM_KEY=replace-with-a-long-random-secret

# Local defaults. Compose overrides these with its persistent container paths.
EXTRACTOR_DB_PATH=./system.db
EXTRACTOR_UPLOAD_DIR=./uploads

# QLever is managed separately and listens on the host at port 7001.
# Compose overrides this URL with http://host.docker.internal:7001.
QLEVER_URL=http://localhost:7001

# Backend-only QLever credential for updates and admin operations.
QLEVER_ACCESS_TOKEN=replace-with-the-qlever-access-token
